# Copier ce fichier en .env et remplir les valeurs

# Identifiants Airbnb
AIRBNB_EMAIL=votre@email.com
AIRBNB_PASSWORD=votre_mot_de_passe

# URL iCal de votre annonce Airbnb
# Airbnb > Calendrier > Disponibilité > Exporter le calendrier
ICAL_URL=https://www.airbnb.com/calendar/ical/VOTRE_LISTING_ID.ics?s=TOKEN

# Délai avant d'envoyer l'avis (en heures, défaut 48)
REVIEW_DELAY_HOURS=48

# Langue du site Airbnb à utiliser (fr, en, es...)
AIRBNB_LOCALE=fr

# Mode debug : ouvre le navigateur visible (true) ou invisible (false)
HEADLESS=false
